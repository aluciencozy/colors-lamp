{
  "name": "colors-lamp",
  "version": "1.0.0",
  "private": true,
  "description": "Linting tools for the Colors LAMP application",
  "scripts": {
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "htmlhint --ignore node_modules \"**/*.html\"",
    "lint:css": "stylelint \"**/*.css\" --ignore-pattern \"node_modules/**\" --max-warnings 0",
    "lint:js": "eslint \"js/**/*.js\" --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "htmlhint": "^1.9.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
